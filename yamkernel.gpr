project YaMKernel is

   for Languages use ("Ada");
   for Source_Dirs use ("src/**");
   for Ignore_Source_Sub_Dirs use ("arch");
   for Object_Dir use "obj";
   for Main use ("yamkernel.adb");
--   for Runtime ("ada") use "light-rpi3";
   type Loader_Type is
      ("USER");
   Loader : Loader_Type := external ("LOADER", "USER");
   type Build_Type is
      ("Debug");
   Build : Build_Type := external ("BUILD", "Debug");

   package Compiler is
      for Switches ("ada") use ("-O0", "-ggdb", "-g");
   end Compiler;

   package Emulator is
      --   for Board use "rpi3b";
      --for Switches use ("Sw1", "Sw2");
   end Emulator;

   package Builder is
      for Switches ("ada") use ("-g");
   end Builder;

   package Linker is
      for Switches ("ada") use ("-T", "linker/rspi3-linker.ld", "-g");
   end Linker;

   for Target use "aarch64-elf";
   for Runtime ("ada") use project'Project_Dir & "/src/arch/rpi3/light-rpi3";

end YaMKernel;

